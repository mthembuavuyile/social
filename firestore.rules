rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is the author
    function isAuthor(item) {
      return isAuthenticated() && item.authorUid == request.auth.uid;
    }

    // Helper to validate string length
    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && isValidString(request.resource.data.content, 2000)
        && isValidString(request.resource.data.author, 100)
        && (!('location' in request.resource.data) || isValidString(request.resource.data.location, 200))
        && (!('city' in request.resource.data) || isValidString(request.resource.data.city, 100))
        && (!('province' in request.resource.data) || isValidString(request.resource.data.province, 100))
        // Crime report fields validation
        && (!('reportType' in request.resource.data) || request.resource.data.reportType in ['civic', 'crime'])
        && (!('crimeUrgency' in request.resource.data) || request.resource.data.crimeUrgency in ['low', 'medium', 'high', 'emergency'])
        && (!('incidentTime' in request.resource.data) || isValidString(request.resource.data.incidentTime, 100))
        && (!('caseNumber' in request.resource.data) || isValidString(request.resource.data.caseNumber, 100))
        && (!('policeContacted' in request.resource.data) || request.resource.data.policeContacted is bool)
        && (!('anonymous' in request.resource.data) || request.resource.data.anonymous is bool);

      allow delete: if isAuthor(resource.data);
      
      allow update: if isAuthenticated() && (
        // Authors can update their own posts freely
        isAuthor(resource.data) || (
          // Non-authors can ONLY update reactions and userReactions.
          // All other fields must remain unchanged.
          request.resource.data.content == resource.data.content &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.author == resource.data.author &&
          request.resource.data.timestamp == resource.data.timestamp &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'userReactions'])
        )
      );

    }
  }
}
